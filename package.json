{
  "name": "browso",
  "productName": "Browso",
  "version": "1.0.0-beta.1",
  "description": "A layered AI browser copilot, autonomous web agent, and local knowledge browser.",
  "main": "./out/main/index.js",
  "author": "Xaroq",
  "homepage": "https://github.com/Xaroq/browso",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "test:smoke": "node --test --experimental-strip-types test/**/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=cobertura --reports-dir=coverage node --test --experimental-strip-types test/**/*.test.ts",
    "benchmark": "node scripts/benchmark.mjs --source . --output benchmark-results/browso.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview -c browso.vite.config.ts",
    "dev": "electron-vite dev -c browso.vite.config.ts",
    "build": "npm run typecheck && electron-vite build -c browso.vite.config.ts",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir -c browso-builder.yml",
    "build:win": "npm run build && electron-builder --win nsis --x64 -c browso-builder.yml --config.publish.channel=win-x64",
    "build:mac": "electron-vite build -c browso.vite.config.ts && electron-builder --mac -c browso-builder.yml",
    "build:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64 -c browso-builder.yml --config.publish.channel=mac-arm64",
    "build:mac:x64": "npm run build && electron-builder --mac dmg zip --x64 -c browso-builder.yml --config.publish.channel=mac-x64",
    "build:linux": "electron-vite build -c browso.vite.config.ts && electron-builder --linux AppImage --x64 -c browso-builder.yml --config.publish.channel=linux-x64"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.17",
    "@ai-sdk/openai": "^2.0.30",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-slot": "^1.2.3",
    "ai": "^5.0.44",
    "ai-sdk-ollama": "^0.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "c8": "^11.0.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5"
  }
}
